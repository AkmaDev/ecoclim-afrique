    "@type": "ProfessionalService",
    "name": "ECOCLIM AFRIQUE EXPERTISE",
    "description": "Cabinet de conseil environnemental spécialisé en droit de l'environnement, marchés carbone, gestion des catastrophes et décarbonisation en Afrique.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "BJ",
      "addressLocality": "Cotonou"
    },
    "telephone": "+22901602064",
    "email": "akremy@ecoclimafrique.com",
    "areaServed": "Afrique",
    "knowsLanguage": ["fr"],
    "serviceType": ["Conseil environnemental", "Droit de l'environnement", "Marchés carbone", "Décarbonisation"]
  }
