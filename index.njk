    <!-- =========================================================
         SECTION 5 — STATS
    ========================================================== -->
    <section class="stats" data-scroll-section>
      <div class="container">
        <div class="stats__grid">
          <div class="stats__item">
            <div class="stats__number" data-count="14" data-prefix="+">+14</div>
            <div class="stats__label">ans d'expertise environnementale en Afrique</div>
          </div>
          <div class="stats__item">
            <div class="stats__number" data-count="47">47</div>
            <div class="stats__label">projets réalisés sur le continent</div>
          </div>
          <div class="stats__item">
            <div class="stats__number" data-count="3500" data-suffix=" ha">3 500 ha</div>
