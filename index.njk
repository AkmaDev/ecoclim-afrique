        ECOCLIM AFRIQUE
      </a>

      <div class="nav__links">
        <a href="services.html" class="nav__link">Services</a>
        <a href="apropos.html" class="nav__link">À Propos</a>
        <a href="actualites.html" class="nav__link">Actualités</a>
        <a href="contact.html" class="nav__cta">
          <span>Nous contacter</span>
          <span class="btn__arrow">→</span>
        </a>
      </div>

      <button class="nav__burger" id="navBurger" aria-label="Menu">
        <span class="nav__burger-line"></span>
        <span class="nav__burger-line"></span>
        <span class="nav__burger-line"></span>
      </button>
    </div>
  </nav>

