          </a>
        </div>

        <div class="bento-grid">
          <!-- Tile 1 — Large -->
          <a href="service-droit.html" class="service-tile service-tile--large">
            <span class="service-tile__num">01</span>
            <div class="service-tile__body">
              <div class="service-tile__icon">⚖️</div>
              <h3 class="service-tile__title">Droit de l'Environnement</h3>
              <p class="service-tile__desc">Audits réglementaires, veille juridique, contentieux environnemental, contrats verts et conseil en fiscalité environnementale.</p>
            </div>
            <div class="service-tile__footer">
              <span class="service-tile__tag">Réglementation · Conformité</span>
              <span class="service-tile__arrow">→</span>
            </div>
          </a>

          <!-- Tile 2 -->
          <a href="service-gestion.html" class="service-tile service-tile--sm1">
            <span class="service-tile__num">02</span>
            <div class="service-tile__body">
              <div class="service-tile__icon">🌿</div>
              <h3 class="service-tile__title">Gestion de l'Environnement</h3>
              <p class="service-tile__desc">Études d'impact, systèmes ISO 14001, gestion des déchets, biodiversité.</p>
            </div>
            <div class="service-tile__footer">
              <span class="service-tile__tag">EIE · ISO 14001</span>
              <span class="service-tile__arrow">→</span>
            </div>
          </a>

          <!-- Tile 3 -->
          <a href="service-catastrophes.html" class="service-tile service-tile--sm2">
            <span class="service-tile__num">03</span>
            <div class="service-tile__body">
              <div class="service-tile__icon">🛡️</div>
              <h3 class="service-tile__title">Gestion des Catastrophes</h3>
              <p class="service-tile__desc">Analyse des vulnérabilités, plans de contingence, systèmes d'alerte précoce.</p>
            </div>
            <div class="service-tile__footer">
              <span class="service-tile__tag">Résilience · DRR</span>
              <span class="service-tile__arrow">→</span>
            </div>
          </a>

          <!-- Tile 4 -->
          <a href="service-carbone.html" class="service-tile service-tile--sm3">
            <span class="service-tile__num">04</span>
            <div class="service-tile__body">
              <div class="service-tile__icon">💹</div>
              <h3 class="service-tile__title">Marchés Carbone</h3>
              <p class="service-tile__desc">Identification de projets, développement, Gold Standard, VCS/Verra, conseil en financement.</p>
            </div>
            <div class="service-tile__footer">
              <span class="service-tile__tag">Verra · Gold Standard</span>
              <span class="service-tile__arrow">→</span>
            </div>
          </a>

          <!-- Tile 5 — Wide -->
          <a href="service-decarbonisation.html" class="service-tile service-tile--wide">
            <span class="service-tile__num">05</span>
            <div class="service-tile__body">
              <div class="service-tile__icon">♻️</div>
              <h3 class="service-tile__title">Décarbonisation</h3>
              <p class="service-tile__desc">Bilan carbone Scope 1, 2 et 3, stratégies Net Zero, alignement SBTi, audits énergétiques. Accompagnement complet vers la neutralité carbone.</p>
            </div>
            <div class="service-tile__footer">
              <span class="service-tile__tag">Scope 1·2·3 · Net Zero · SBTi</span>
              <span class="service-tile__arrow">→</span>
            </div>
