  <script>
    // Lien d'invitation / réinitialisation Netlify Identity → tableau de bord
    if (window.netlifyIdentity) {
      netlifyIdentity.on("init", user => {
        if (!user) netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
      });
    }
  </script>
