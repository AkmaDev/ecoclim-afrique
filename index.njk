          <span class="hero__marquee-item">Afrique de l'Ouest</span>
          <span class="hero__marquee-item">Marchés Carbone</span>
          <span class="hero__marquee-item">ISO 14001</span>
          <span class="hero__marquee-item">Net Zero</span>
          <span class="hero__marquee-item">Verra · Gold Standard</span>
          <span class="hero__marquee-item">Scope 1 · 2 · 3</span>
          <span class="hero__marquee-item">SBTi</span>
          <span class="hero__marquee-item">Audit Conformité</span>
          <!-- Duplicate for seamless loop -->
          <span class="hero__marquee-item">Bénin</span>
          <span class="hero__marquee-item">Afrique de l'Ouest</span>
          <span class="hero__marquee-item">Marchés Carbone</span>
          <span class="hero__marquee-item">ISO 14001</span>
          <span class="hero__marquee-item">Net Zero</span>
          <span class="hero__marquee-item">Verra · Gold Standard</span>
          <span class="hero__marquee-item">Scope 1 · 2 · 3</span>
          <span class="hero__marquee-item">SBTi</span>
          <span class="hero__marquee-item">Audit Conformité</span>
        </div>
      </div>
