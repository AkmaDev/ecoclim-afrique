              <a href="mailto:akremy@ecoclimafrique.com" class="contact-cta__info-value">
                akremy@ecoclimafrique.com
              </a>
            </div>
            <div class="contact-cta__info">
              <span class="contact-cta__info-label">Téléphone</span>
              <a href="tel:+22901602064" class="contact-cta__info-value">
                +229 01 60 20 64 64
              </a>
            </div>
            <div style="margin-top: var(--space-sm)">
              <a href="contact.html" class="btn btn--primary">
                <span>Nous contacter</span>
                <span class="btn__arrow">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
