          loading="lazy"
          style="object-position:center 20%"
        >
        <div class="about-split__image-overlay"></div>
      </div>

      <!-- Content -->
      <div class="about-split__content">
        <div class="about-split__label">
          <span class="label-tag">Notre cabinet</span>
        </div>
        <h2 class="about-split__title" id="aboutTitle">
          Une synergie d'expertises au service de l'Afrique
        </h2>
        <p class="about-split__text" id="aboutText">
          Fondé à Cotonou, Bénin, ECOCLIM AFRIQUE EXPERTISE réunit des spécialistes du droit environnemental, du climat et de la résilience des territoires. Notre cabinet intervient sur l'ensemble du continent pour accompagner entreprises, États et organisations internationales dans leur transition écologique.
        </p>

        <div class="about-split__values" id="aboutValues">
          <div class="about-split__value">
            <span class="about-split__value-name">Intégrité</span>
            <span class="about-split__value-desc">Éthique · Rigueur</span>
          </div>
          <div class="about-split__value">
            <span class="about-split__value-name">Innovation</span>
            <span class="about-split__value-desc">Solutions · Impact</span>
          </div>
          <div class="about-split__value">
            <span class="about-split__value-name">Engagement</span>
            <span class="about-split__value-desc">Afrique · Durabilité</span>
          </div>
        </div>

        <a href="apropos.html" class="btn btn--ghost">
          Découvrir l'équipe <span class="btn__arrow">→</span>
        </a>
      </div>
    </section>

    <!-- =========================================================
         SECTION 7 — BLOG / ACTUALITÉS
    ========================================================== -->
    {% if collections.posts.length %}
    <section class="blog-section" data-scroll-section>
      <div class="container">
        <div class="blog-section__header">
          <h2 class="blog-section__title">Décrypter les enjeux climatiques</h2>
          <p class="blog-section__sub">Analyses et perspectives pour mieux décider face aux défis environnementaux africains.</p>
        </div>
      </div>

      <div class="container" style="overflow:visible; padding-right:0;">
        <div class="blog-track" id="blogTrack">
          {% set headingTag = "h3" %}{% for post in collections.posts | head(6) %}{% include "post-card.njk" %}
          {% endfor %}
        </div>
      </div>

      <div class="container" style="margin-top: var(--space-xl)">
        <a href="actualites.html" class="btn btn--ghost">
          Toutes les actualités <span class="btn__arrow">→</span>
        </a>
