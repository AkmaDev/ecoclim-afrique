permalink: actualites.html
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Actualités — ECOCLIM AFRIQUE EXPERTISE</title>
  <meta name="description" content="Analyses et perspectives sur les enjeux climatiques et environnementaux en Afrique. Marchés carbone, droit environnemental, résilience climatique.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.css">
  <link rel="stylesheet" href="css/tokens.css?v=3">
  <link rel="stylesheet" href="css/reset.css?v=3">
  <link rel="stylesheet" href="css/base.css?v=3">
  <link rel="stylesheet" href="css/animations.css?v=3">
  <link rel="stylesheet" href="css/nav.css?v=4">
  <link rel="stylesheet" href="css/sections.css?v=6">
  <style>
    .blog-page-header {
      padding-top: calc(var(--nav-height) + var(--space-2xl));
      padding-bottom: var(--space-2xl);
      border-bottom: 1px solid var(--border);
    }
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
      padding-block: var(--space-3xl);
    }
    .blog-grid .blog-card { width: auto; flex-shrink: unset; opacity: 1; transform: none; }
    .blog-empty { padding-block: var(--space-3xl); color: var(--text-tertiary); font-size: var(--text-lg); }
    @media (max-width:900px) { .blog-grid { grid-template-columns: repeat(2,1fr); } }
    @media (max-width:600px) { .blog-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

  <nav class="nav scrolled" id="nav">
    <div class="nav__inner">
      <a href="index.html" class="nav__logo"><img src="assets/images/logo-ecoclim.png" alt="Logo Ecoclim Afrique Expertise" class="nav__logo-img" width="40" height="40">ECOCLIM AFRIQUE</a>
      <div class="nav__links">
        <a href="services.html" class="nav__link">Services</a>
        <a href="apropos.html" class="nav__link">À Propos</a>
        <a href="actualites.html" class="nav__link active">Actualités</a>
        <a href="contact.html" class="nav__cta"><span>Nous contacter</span><span class="btn__arrow">→</span></a>
      </div>
      <button class="nav__burger" id="navBurger"><span class="nav__burger-line"></span><span class="nav__burger-line"></span><span class="nav__burger-line"></span></button>
    </div>
  </nav>

  <div class="nav__mobile" id="navMobile">
    <button class="nav__mobile-close" id="navClose">✕</button>
    <nav class="nav__mobile-links">
      <a href="services.html" class="nav__mobile-link">Services</a>
      <a href="apropos.html" class="nav__mobile-link">À Propos</a>
      <a href="actualites.html" class="nav__mobile-link">Actualités</a>
      <a href="contact.html" class="nav__mobile-link" style="color:var(--accent)">Contact →</a>
    </nav>
  </div>

  <main data-scroll-container id="scroll-container">
    <div class="blog-page-header" data-scroll-section>
      <div class="container">
        <div style="margin-bottom:var(--space-lg)"><span class="label-tag">Analyses & Perspectives</span></div>
        <h1 style="font-family:var(--font-display);font-size:var(--text-hero);font-weight:600;letter-spacing:-0.04em;line-height:0.95;color:var(--text-primary);margin-bottom:var(--space-lg)">
          Décrypter les<br>enjeux climatiques.
        </h1>
        <p style="font-size:var(--text-lg);color:var(--text-secondary);font-weight:300;max-width:560px;line-height:1.6">
          Nos analyses pour mieux comprendre et décider face aux défis environnementaux en Afrique.
        </p>
      </div>
    </div>

    <section data-scroll-section>
      <div class="container">
        {% if collections.posts.length %}
        <div class="blog-grid">
          {% for post in collections.posts %}{% include "post-card.njk" %}
          {% endfor %}
        </div>
        {% else %}
        <p class="blog-empty">Publications à venir.</p>
        {% endif %}
      </div>
    </section>

    <footer class="footer" data-scroll-section>
      <div class="container">
        <div class="footer__bottom">
          <p class="footer__copy">© 2025 ECOCLIM AFRIQUE EXPERTISE. Tous droits réservés.</p>
          <a href="index.html" class="footer__link">← Retour à l'accueil</a>
        </div>
      </div>
    </footer>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.js"></script>
  <script src="js/nav.js?v=3"></script>
  <script src="js/locomotive.js?v=3"></script>
</body>
</html>
