<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set pageUrl = page.url | absUrl -%}
  {%- if draft %}{% set shareImage = "" %}{% else %}{% set shareImage = image | shareImage %}{% endif -%}
  {%- set desc = excerpt | metaDesc %}
  <title>{{ title }} — ECOCLIM AFRIQUE EXPERTISE</title>
  <meta name="description" content="{{ desc }}">
  <link rel="canonical" href="{{ pageUrl }}">

  <!-- Aperçu de partage (WhatsApp, LinkedIn, Facebook, X) -->
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:image:alt" content="{{ title }}">
  <meta property="article:author" content="{{ author or 'Remy AKPOVI' }}">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ desc }}">
  <meta name="twitter:image" content="{{ shareImage }}">

  <!-- Données structurées pour Google -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | jsonString | safe }},
    "description": {{ desc | jsonString | safe }},
    "image": [{{ shareImage | jsonString | safe }}],
    "datePublished": "{{ page.date | isoDate }}",
    "dateModified": "{{ page.date | isoDate }}",
    "inLanguage": "fr",
    "mainEntityOfPage": {{ pageUrl | jsonString | safe }},
    {% if category %}"articleSection": {{ category | jsonString | safe }},{% endif %}
    "author": { "@type": "Person", "name": {{ (author or "Remy AKPOVI") | jsonString | safe }}, "url": "{{ '/apropos.html' | absUrl }}" },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "logo": { "@type": "ImageObject", "url": "{{ '/assets/images/logo-ecoclim.png' | absUrl }}" }
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.css">
  <link rel="stylesheet" href="/css/tokens.css?v=7">
  <link rel="stylesheet" href="/css/reset.css?v=7">
  <link rel="stylesheet" href="/css/base.css?v=8">
  <link rel="stylesheet" href="/css/animations.css?v=7">
  <link rel="stylesheet" href="/css/nav.css?v=7">
  <link rel="stylesheet" href="/css/sections.css?v=10">
</head>
<body>

  <nav class="nav scrolled" id="nav">
    <div class="nav__inner">
      <a href="/index.html" class="nav__logo"><img src="/assets/images/logo-ecoclim.png" alt="Logo Ecoclim Afrique Expertise" class="nav__logo-img" width="40" height="40">ECOCLIM AFRIQUE</a>
      <div class="nav__links">
        <a href="/services.html" class="nav__link">Services</a>
        <a href="/apropos.html" class="nav__link">À Propos</a>
        <a href="/actualites.html" class="nav__link active">Actualités</a>
        <a href="/contact.html" class="nav__cta"><span>Nous contacter</span><span class="btn__arrow">→</span></a>
      </div>
      <button class="nav__burger" id="navBurger"><span class="nav__burger-line"></span><span class="nav__burger-line"></span><span class="nav__burger-line"></span></button>
    </div>
  </nav>

  <div class="nav__mobile" id="navMobile">
    <button class="nav__mobile-close" id="navClose">✕</button>
    <nav class="nav__mobile-links">
      <a href="/services.html" class="nav__mobile-link">Services</a>
      <a href="/apropos.html" class="nav__mobile-link">À Propos</a>
      <a href="/actualites.html" class="nav__mobile-link">Actualités</a>
      <a href="/contact.html" class="nav__mobile-link" style="color:var(--accent)">Contact →</a>
    </nav>
  </div>

  {%- import "share.njk" as shareFloat %}
  <aside class="share-float" id="shareFloat" aria-label="Partager">
    <span class="share-float__label">Partager</span>
    {{ shareFloat.buttons(pageUrl, title, true, true) }}
  </aside>

  <main data-scroll-container id="scroll-container">
    {%- import "share.njk" as share -%}
    {%- set auteurNom = author or "Remy AKPOVI" -%}
    {%- set auteur = auteurs[auteurNom] -%}
    <article class="article" data-scroll-section>
      <div class="container article__container">
        <a href="/actualites.html" class="article__back">← Toutes les actualités</a>
        <header class="article__header">
          {% if category %}<span class="blog-card__category">{{ category }}</span>{% endif %}
          <h1 class="article__title">{{ title }}</h1>
          {% if excerpt %}<p class="article__lead">{{ excerpt }}</p>{% endif %}
        </header>

        <div class="byline">
          <div class="byline__author">
            {% if auteur and auteur.photo %}<img class="byline__avatar" src="{{ auteur.photo }}" alt="" width="44" height="44">{% endif %}
            <div>
              <p class="byline__name">{{ auteurNom }}{% if auteur %}<span class="byline__role"> · {{ auteur.role }}</span>{% endif %}</p>
              <p class="byline__meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | dateLongue }}</time> · {{ content | tempsLecture }}</p>
            </div>
          </div>
          {{ share.buttons(pageUrl, title, true) }}
        </div>

        {% if image %}
        <figure class="article__cover"><img src="{{ image }}" alt="" onerror="this.parentElement.remove()"></figure>
        {% endif %}
        <div class="article__body">
          {{ content | safe }}
        </div>

        <section class="article__share" id="shareBottom" aria-label="Partager">
          <p class="article__share-label">Cet article vous a été utile ? Partagez-le</p>
          {{ share.buttons(pageUrl, title) }}
        </section>

        {% if auteur %}
        <aside class="author-card">
          {% if auteur.photo %}<img class="author-card__photo" src="{{ auteur.photo }}" alt="{{ auteurNom }}" width="72" height="72" loading="lazy">{% endif %}
          <div>
            <p class="author-card__label">Écrit par</p>
            <p class="author-card__name">{{ auteurNom }}</p>
            <p class="author-card__role">{{ auteur.role }}</p>
            <p class="author-card__bio">{{ auteur.bio }}</p>
            <a class="author-card__link" href="{{ auteur.lien }}">En savoir plus →</a>
          </div>
        </aside>
        {% endif %}

        <div class="article__cta">
          <div>
            <p class="article__cta-title">Un projet ou une question sur ce sujet ?</p>
            <p class="article__cta-text">Échangeons sur votre situation : conformité, études d'impact, stratégie climat.</p>
          </div>
          <a href="/contact.html" class="btn btn--primary"><span>Prendre contact</span><span class="btn__arrow">→</span></a>
        </div>

        {%- set autres = collections.posts | autresArticles(page.url) %}
        {% if autres.length %}
        <section class="article__related">
          <h2 class="article__related-title">À lire aussi</h2>
          <div class="article__related-grid">
            {% set headingTag = "h3" %}{% for post in autres %}{% include "post-card.njk" %}{% endfor %}
          </div>
        </section>
        {% endif %}
      </div>
    </article>

    <footer class="footer" data-scroll-section>
      <div class="container">
        <div class="footer__bottom">
          <p class="footer__copy">© 2025 ECOCLIM AFRIQUE EXPERTISE. Tous droits réservés.</p>
          <a href="/index.html" class="footer__link">← Retour à l'accueil</a>
        </div>
      </div>
    </footer>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@4.1.4/dist/locomotive-scroll.min.js"></script>
  <script src="/js/nav.js?v=3"></script>
  <script src="/js/locomotive.js?v=4"></script>
  <script>
    // Recalcule la hauteur de défilement une fois les images de l'article chargées
    window.addEventListener('load', () => window.dispatchEvent(new Event('resize')));

    // Barre de partage flottante (grand écran) : visible entre la ligne d'auteur et le partage du bas
    (function () {
      const bar = document.getElementById('shareFloat');
      const top = document.querySelector('.byline');
      const bottom = document.getElementById('shareBottom');
      if (!bar || !top || !bottom || !('IntersectionObserver' in window)) return;
      let topPassed = false, bottomVisible = false;
      const maj = () => bar.classList.toggle('is-visible', topPassed && !bottomVisible);
      new IntersectionObserver(([e]) => { topPassed = !e.isIntersecting && e.boundingClientRect.top < 0; maj(); }).observe(top);
      new IntersectionObserver(([e]) => { bottomVisible = e.isIntersecting || e.boundingClientRect.top < 0; maj(); }).observe(bottom);
    })();

    // Partage natif sur mobile, copie du lien sinon
    document.querySelectorAll('[data-copy]').forEach(btn => btn.addEventListener('click', async () => {
      const url = btn.dataset.copy;
      try {
        if (navigator.share) { await navigator.share({ title: document.title, url }); return; }
        await navigator.clipboard.writeText(url);
        btn.textContent = 'Lien copié ✓';
      } catch (e) { /* partage annulé */ }
    }));
  </script>
</body>
</html>
